<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-8 offset-md-2">
    <h3 class="fw-bold mb-3"><%= listing.title %></h3>
    
    <div class="card show-card listing-card p-0 mb-3">
      <img 
        src="<%= listing.image ? listing.image.url : '' %>" 
        class="card-img-top show-img" 
        alt="<%= listing.image ? listing.image.filename : 'listing_image' %>"
      />
      <div class="card-body p-4">
        <!-- Safe Navigation for Owner -->
        <p><i>Owned By : <%= listing.owner ? listing.owner.username : "Unknown" %></i></p>
        
        <p class="card-text mb-0">
          <%= listing.description %><br>
          <strong class="fs-5">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></strong> / night<br>
          <span class="text-muted"><%= listing.location %>, <%= listing.country %></span>
        </p>
      </div>
    </div>

    <!-- Buttons Row (Only for logged in users / owners) -->
    <% if(currUser && currUser._id.equals(listing.owner._id)) {%>
    <div class="btns d-flex gap-3 mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn theme-btn px-4">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
        <button type="submit" class="btn btn-outline-danger">Delete</button>
      </form>
    </div>
    <% } %>
    <hr class="my-4">

    <!-- Review Form -->
    <% if(currUser) {%>
    <div class="review-section">
      <h3 class="fw-bold">Leave a Review</h3>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        
<div class="mb-3 mt-3">
  <label for="rating" class="form-label fw-semibold"><b>Rating:</b></label>
  <fieldset class="starability-slot">
    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
    <label for="first-rate1" title="Terrible">1 star</label>
    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
    <label for="first-rate2" title="Not good">2 stars</label>
    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
    <label for="first-rate3" title="Average">3 stars</label>
    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
    <label for="first-rate4" title="Very good">4 stars</label>
    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
    <label for="first-rate5" title="Amazing">5 stars</label>
  </fieldset>
</div>
         
        <div class="mt-3 mb-3">
          <label for="comment" class="form-label fw-semibold">Comment</label>
          <textarea 
            name="review[comment]"
            id="comment"
            rows="4"
            class="form-control custom-input"
            required 
          ></textarea>
          <div class="invalid-feedback">
            Please submit some comments for review.
          </div>
        </div>
        <button type="submit" class="btn theme-btn">Submit Review</button>
      </form>
      <hr class="my-4">
      <% } %>  

      <div class="row g-3">
        <h1 class="">All Reviews</h1>
        <% for(review of listing.reviews) { %>
          <div class="col-12 col-md-6">
            <div class="card review-card h-100 p-3">
              <div class="card-body p-0">
                <h5 class="card-title fw-bold">@<%= review.author ? review.author.username : "anonymous" %></h5>
                <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                <p class="card-text mb-2"><%= review.comment %></p>
              </div>
              <form method="POST" action="/listings/<%= listing._id%>/reviews/<%= review._id%>?_method=DELETE">
                <button class="btn btn-sm btn-outline-danger mt-2">Delete</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>